PORT=3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://obd:obd@localhost:5432/obd_gateway?schema=public"

# OBD adapter: mock | elm327
OBD_ADAPTER=mock
# Auto-connect on app boot (recommended for mock)
OBD_AUTO_CONNECT=true
# Poll PIDs and persist to PostgreSQL
OBD_POLL_ENABLED=true
OBD_POLL_INTERVAL_MS=1000

# Serial port settings for real ELM327 adapter
# Windows: COM3, COM4, etc.  Linux/macOS: /dev/ttyUSB0, /dev/tty.usbserial-*, /dev/rfcomm0
OBD_SERIAL_PORT=
OBD_BAUD_RATE=38400
