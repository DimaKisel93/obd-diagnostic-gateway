PORT=3000
DATABASE_URL="postgresql://obd:obd@localhost:5432/obd_gateway?schema=public"
OBD_ADAPTER=mock
OBD_AUTO_CONNECT=true
OBD_POLL_ENABLED=true
OBD_POLL_INTERVAL_MS=1000
OBD_SERIAL_PORT=
OBD_BAUD_RATE=38400
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
OBD_CB_FAILURE_THRESHOLD=5
OBD_CB_COOLDOWN_MS=30000
